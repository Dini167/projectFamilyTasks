<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="lineStart" value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId}" />
  <variable name="lineEnd" value="${logger}|${message} ${exception:format=tostring}" />
  <variable name="lineLayout" value="${lineStart}|${lineEnd}" />

  <targets>
    <target xsi:type="File" name="logfile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${lineLayout}" />

    <target xsi:type="Console" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="logfile,console" />
  </rules>
</nlog>
